{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "phason-engineering-mcp",
      "version": "0.1.0",
      "title": "Phason Engineering Works"
    },
    "tools": [
      {
        "name": "get_company_profile",
        "title": "Get company profile",
        "description": "Get the public company profile for Phason Engineering Works Limited: contact details, core values, key statistics, personnel and equipment capacity, and frequently asked questions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_services",
        "title": "List services",
        "description": "List the engineering and supply services offered by Phason Engineering Works Limited, optionally filtered by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter.",
              "type": "string",
              "enum": [
                "Engineering",
                "Supply"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List completed and ongoing projects in the Phason Engineering portfolio, optionally filtered by category or year.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter, e.g. Roads, Buildings, Water, Civil.",
              "type": "string"
            },
            "year": {
              "description": "Optional year filter.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_blog_posts",
        "title": "List blog posts",
        "description": "List published insight articles from the Phason Engineering blog, newest first. Use `full: true` to include the article body.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "description": "Return only the post with this slug.",
              "type": "string"
            },
            "full": {
              "description": "Include full article body text.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
