# Copy to .env for local dev. On Netlify, set these in
# Site settings → Environment variables.

# --- Public (browser + SSR) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# --- Server-only (Netlify Functions runtime) ---
# Mirror the public values without the VITE_ prefix so server code that reads
# process.env.SUPABASE_* keeps working.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Service role key — BYPASSES RLS. Never expose to the browser.
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Lovable AI Gateway (only if you use AI features)
# LOVABLE_API_KEY=your-lovable-api-key
